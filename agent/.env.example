# ---------------------------------------------------------------------------
# DCW Dahua bridge agent — copy to agent/.env on the office machine
# ---------------------------------------------------------------------------

# --- The controller (LAN) --------------------------------------------------
# IP shown on the device: Menu > Network, or found in ConfigTool / SmartPSS.
DAHUA_HOST=192.168.1.108
DAHUA_USERNAME=admin
DAHUA_PASSWORD=change-me
DAHUA_PROTOCOL=http
# Name that shows up in HRMS > Biometric.
DAHUA_DEVICE_NAME=Reception Gate

# --- The CRM (Railway) -----------------------------------------------------
CRM_BASE_URL=https://dcwcrm-production.up.railway.app
# Must match BIOMETRIC_WEBHOOK_SECRET in the Railway service variables.
BIOMETRIC_WEBHOOK_SECRET=

# --- Tuning (safe defaults, change only if needed) -------------------------
BIOMETRIC_POLL_MINUTES=10
BIOMETRIC_POLL_LOOKBACK_HOURS=12
BIOMETRIC_HEARTBEAT_SECONDS=60
